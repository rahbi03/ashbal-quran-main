# انسخ هذا الملف إلى .env محليًا وضع القيم الحقيقية. لا ترفع .env إلى Git إطلاقًا.
# على Vercel لا تحتاج هذا الملف — ضع القيم في Project Settings → Environment Variables.

# رابط قاعدة Supabase.
#
# على Vercel (بيئة Serverless) استخدم «Transaction pooler» على المنفذ 6543:
#   - كل نسخة دالة قصيرة العمر وتفتح اتصالًا وتغلقه، فمجمّع الجلسات (5432)
#     يستنزف حدّ الاتصالات سريعًا. مجمّع المعاملات (6543) مصمّم لهذا النمط.
#   - أضف ?sslmode=require في نهاية الرابط.
#
# محليًا (خادم دائم) يعمل مجمّع الجلسات 5432 كما هو.
# إن احتوت كلمة المرور رموزًا خاصة شفّرها: @→%40  #→%23  /→%2F
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require

# سر عشوائي لتوقيع كوكيز الجلسة. ولّده بـ:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
